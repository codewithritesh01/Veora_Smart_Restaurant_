# Veora Restaurant Backend - Environment Configuration Template
# Copy this file to '.env' and fill in your actual values.

# The connection URL for MongoDB Atlas (or local MongoDB)
MONGODB_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/"

# The database name to use in MongoDB
DATABASE_NAME="veora_restaurant"

# A secure random cryptographic secret used for signing JWT tokens
# e.g., generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your_super_secret_key_here"

# Comma-separated list of allowed CORS origins in production
# Set this to your deployed React app URL and localhost for testing
ALLOWED_ORIGINS="https://your-frontend-domain.vercel.app,http://localhost:5173"
